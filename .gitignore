# ===========================================
# JurixAI — Comprehensive .gitignore
# ===========================================

# Environments & Secret Keys
.env
.env.*
**/.env
**/.env.*
*.local
!**/.env.example

# Python / Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / cache / optimized files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Distribution / Packaging
build/
develop-eggs/
dist/
**/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
*.whl

# Installer logs & unit tests
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
*.cover
*.py,cover
.pytest_cache/

# Static type checkers & linters
.mypy_cache/
.pytype/
.pyre/
.ruff_cache/

# ChromaDB / Vector Store Data
# Ignore root empty stub directory
/Jurixai_db/
/chroma.sqlite3
# Explicitly track production vector database in backend/
!backend/Jurixai_db/
!backend/Jurixai_db/**

# Local model cache — large binary weights, not needed in git (Docker COPY handles it)
backend/local_model_cache/

# Frontend directory (managed separately / excluded from repository)
frontend/

# Node.js / Frontend dependencies & caches
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
.npm/
.yarn/
.vite/
**/.vite/
.parcel-cache/
.turbo/
dist-ssr/
**/dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project
*.code-workspace

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Archive / Large Artifacts
*.zip
*.tar.gz
*.rar
backend.zip

# Temporary / Scratch Files
*.bak
*.tmp
*.temp
*.swp
*.swo
*~
context.txt