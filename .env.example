# ===========================================
# JurixAI Backend — Environment Variables
# ===========================================

# Google Gemini API Key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Primary backend secret role key (bypasses RLS for administrative access)
SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key
# Legacy fallback: SUPABASE_SERVICE_KEY=your_supabase_secret_service_role_key

# Supabase Anonymous Public Key (for user authentication / client-scoped auth actions)
SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Allowed CORS Origins (comma-separated list of frontend origins, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini Models fallback cascade (comma-separated, in priority order)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.7-flash

# Maximum file upload size in megabytes (default: 8)
MAX_UPLOAD_MB=8

# Maximum characters allowed per chat user message (default: 4000)
MAX_MESSAGE_CHARS=4000

# Chroma Vector Database directory
CHROMA_DIR=./Jurixai_db

# Optional: Custom path to Tesseract OCR executable (if not installed in standard PATH)
# Windows example: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Docker default is already on PATH (/usr/bin/tesseract)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

