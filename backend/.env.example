# ===========================================
# JurixAI Backend — Environment Variables
# ===========================================

# Google Gemini API Key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_secret_service_role_key
# Alternatively: SUPABASE_SECRET_KEY=your_supabase_secret_service_role_key

# Optional: Custom path to Tesseract OCR executable (if not installed in standard PATH)
# Windows example: TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux / Docker default is already on PATH (/usr/bin/tesseract)
